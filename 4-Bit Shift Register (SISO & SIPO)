module siso_shift(
 input clk,
 input reset,input sin,
 output sout
);
reg [3:0] q;
always @(posedge clk or posedge reset)
begin
 if(reset)
 q <= 4'b0000;
 else
 q <= {q[2:0], sin}; // shift left
end
assign sout = q[3];
endmodule




