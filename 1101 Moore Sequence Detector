Verilog Code
module seq1101(clk, reset, x, z);
input clk, reset, x;
output reg z;
reg [2:0] state;
parameter S0=0,S1=1,S2=2,S3=3,S4=4;
always @(posedge clk or posedge reset)
if(reset)
state<=S0;
else
case(state)
S0: state <= x ? S1 : S0;
S1: state <= x ? S2 : S0;
S2: state <= x ? S2 : S3;
S3: state <= x ? S4 : S0;
S4: state <= x ? S2 : S0;
endcase
always @(state)
if(state==S4)z=1;
else
z=0;
endmodule


