module BCD_adder(A,B,Cin,Sum,Cout);
input [3:0] A,B;
input Cin;

output reg [3:0] Sum;
output reg Cout;
reg [4:0] temp;
always @(*)
begin
temp = A + B + Cin;
if(temp > 9)
begin
temp = temp + 6;
Cout = 1;
end
else
Cout = 0;
Sum = temp[3:0];
end
endmodule


